{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"rootDir": "./src",
		"outDir": "./dist",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"moduleResolution": "bundler",
		"ignoreDeprecations": "6.0"
	},
	"include": ["src/**/*.ts"],
	"exclude": ["dist", "node_modules", "prisma.config.ts"]
}
